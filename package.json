{
  "name": "julie-fleur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build-review.mjs",
    "preview": "wrangler dev --ip 0.0.0.0 --port 3000 --inspector-port 0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:catalog": "node --experimental-strip-types scripts/check-catalog.ts",
    "prepare:photos": "node scripts/prepare-photography.mjs",
    "build:cloudflare": "npm run build && node scripts/build-worker.mjs",
    "check:review": "node --experimental-strip-types scripts/check-review.ts",
    "check:publish": "node scripts/check-publish.mjs",
    "setup:git": "git config core.hooksPath .githooks",
    "check:ecwid": "node --experimental-strip-types scripts/check-ecwid.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": "22.x"
  }
}
